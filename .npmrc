# The bash-based npm scripts (build:game, build:webgl, package:demo,
# deploy, release) are written for Git Bash/MSYS: they use /c/... paths
# and `pwd -W`. Without this, Windows npm runs scripts via cmd.exe, which
# resolves bare `bash` to C:\Windows\System32\bash.exe (WSL) where those
# paths break. Pin script execution to Git Bash so every machine behaves.
script-shell=C:/Program Files/Git/bin/bash.exe
