# ----------------------------------------------------------------------
# Apache config for a static SPA (Vite + React Router).
# This file is copied verbatim into dist/ by Vite during `npm run build`.
# ----------------------------------------------------------------------

# --- SPA fallback: any non-file, non-directory URL serves index.html ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # If the request maps to an existing file, dir, or symlink, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]
  # Otherwise, hand the request to the SPA.
  RewriteRule ^ index.html [L]
</IfModule>

# --- Long cache for fingerprinted assets, no cache for index.html ---
<IfModule mod_headers.c>
  # Hashed files in /assets/ are safe to cache forever.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # index.html must always be revalidated so clients get new asset URLs.
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Basic security headers.
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "interest-cohort=()"
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# --- MIME types ---
<IfModule mod_mime.c>
  AddType application/javascript  .mjs
  AddType application/wasm        .wasm
  AddType font/woff2              .woff2
  AddType image/svg+xml           .svg
  AddType image/avif              .avif
  AddType image/webp              .webp
</IfModule>

# --- Disable directory listings ---
Options -Indexes

# --- Default document ---
DirectoryIndex index.html
